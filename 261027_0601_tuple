# 튜플
# 형식: (값1, 값2, 값3, ...)
# - 좌표나 (이름, 값) 처럼 짝지어진 값을 하나로 묶을 때
sensor = ('모터온도', 78)
print(sensor)      # '모터온도', 78
one= (78,)         # 값이 한개라도 , 표시해야 튜플로 인지
not_tuple = (78)
print(type(one), type(not_tuple))     # <class 'tuple' <class 'int'>

# 튜플 인덱싱, 슬라이싱
s = ('모터온도',78,'C')   # 튜플
print(s[0],s[-1])   # 모터온도 C
readings= (78,80,79,95,77)
print(readings[1:4])  # 80 79 95

# 튜플 언패킹 - 한 번에 변수로 분리
# 형식: 변수1, 변수2 = 튜플   (변수 개수가 튜플 값 개수와 일치해야함)
name, value = sensor
print(name), print(value)

print('실습1: 센서를 튜플로 묶고 꺼내기')
sensor= ('모터온도',78)
print(sensor)                # ('모터온도',78)
print(sensor[0],sensor[1])   # 모터온도 78
name, temp= sensor
print(name,temp)             # 모터온도 78

# 튜플리스크 + 반복문(언패킹)
# - (이름, 값) 튜플들을 리스트로 모아 for 순회하면 이름, 값이 자동 분히
sensors = [('모터온도',78),('펌프압력',95)]
for name,value in sensors:     # for 뒤에 unpacked값을 넣어줌으로써, name=0번째 값이고 value=1번째 값으로 쪼개짐
    print(value)

print('실습2: 튜플 리스트를 반복 처리하기')
sensors= [('모터온도', 75),('회전속도', 99), ('펌프압력',95), ('유량',42)]
for name,value in sensors:
    #print(name,value)     # print(sensors) -> 튜플 리스트가 2번 반복해서 출력된다.
    if value>90:
        print(name,'경고')

# 중첩 튜플
sensors = ('모터온도',78,(3,5))
print(sensors[2])    # (3,5)
print(sensors[2][0])   # 2번-> 2번의 0-> 안으로 접근-> 출력: 3

# 튜플 리스트 정렬
sensors = [(78,'모터온도'),(95,'베어링진동'),(32,'펌프압력')]
high = sorted(sensors)   # 오름차순 정렬
print(high)

high= sorted(sensors,reverse=True)
print(high)   # 내림차순 정렬

print('실습3: 중첩 튜플로 센서 위치 관리하기')
s2= [('펌프압력',1.5,(8,9)),('모터회전속도',2,(7,8)),('베어링진동',5,(3,4))]
for name, value, (x,y) in s2:
    print(name,'위치:',(x,y))
    if x<=5:
        print(name)
