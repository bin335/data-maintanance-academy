# 매개변수와 반환값

# 매개변수와 인자
# 형식:
# def 함수이름(매개변수):
#  ....
# 호출 
# 함수이름(인자)

def check(name):    # name= 매개변수 -> 정의할 때
    print(name+'점검을 시작합니다')

check('압축기1')     # '압축기1'= 인자 -> 호출할 때
check('펌프1')    
# check()   # Typeerror: check() missing
# check('A','B') -> 인자 여러개 출력하고 싶으면 나눠서 하라

print('실습2: 다중 매개변수로 센서값 계산하기')
def check(name, value):
    print(name, value, '도')
check('모터',78)
check('펌프',92)

# 키워드 인자
def report(name,temp):
    print(name,temp,'도')

report(temp=78, name='펌프')

print('실습3: 키워드 인자로 함수 호출하기')
def report(name,value):
    print(name,value)

report(value=78,name='모터')
report(value=92,name='펌프')

# return
# - print: 사람이 확인할 수 있게 출력 / return : 값을 프로그램에게 돌려줘서 이어 쓸 수 있게 한다
def add(a,b):
    return a+b
    print('실행안됨')         # return 만나면 즉시 함수 종료 -> 그 아래 코드 실행 x

print('실습4: 반환값으로 간단 계산기 만들기')
def add(a,b):
    return a+b  # 돌려주기
total= add(80,5)  # 받기
print(total)

total= add(total,5)
print(total)

# 여러 값 반환/ 언패킹
# - 쉼표로 여러 값을 return 하면 튜플로 묶여서 돌아옴 -> 언패킹 가능
def min_max(values):
    return min(values), max(values)
print(min_max([75,10,100]))  # (10,100) -> 결과값이 튜플 형태로 반환된다
low, high = min_max([75,10,100])
print(low,high)  # 10,100 -> 튜플이 unpacking

none= report('펌프',10)
print(none)   # None -> return값이 없는 함수 호출해서 변수로 받을 경우 None

print('실습5: 센서 통계 함수 만들기')
list= [75,10,100]
def min_max(values):
    return min(values),max(values), round(sum(values)/len(values),1)
low,hugh,mean = min_max(list)
print('최소',low,'최대',high,'평균',mean)

print('혼자해봄')
def min_max(values,unit='bar'):
    return min(values), max(values), round(sum(values)/len(values),2) 
pressures = [7.2, 8.5, 6.8, 9.1, 7.9]
low,high,mean = min_max(pressures)
print(low,high,mean)