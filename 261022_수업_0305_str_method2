# replace - 바꾸기/지우기
# 형식: 문자열.replace('바꿀것','새것')
# - 모두 바꾸기, 결과 저장 필요

print('정 상 가 동'.replace(' ',''))  # 정상가동: 공백을 없애라
print('010-1234-5678'.replace('-',''))  # 01012345678: 하이픈을 없애라
print('3,000'.replace(',',''))  # 3000: 콤마를 없애라

# split- 구분자로 나누기 (결과-> 리스트)
# 형식: 문자열.split('구분자')  (구분자 생략 = 공백 기준)
print('A1 A2 A3.split()')
print('사과','배','감.split(,)')  # 특정 구분자로 나누기
# 특정 자리까지만 나누기 (문자열.split('구분자','횟수')) -> 첫번째 구분자를 기준으로 횟수만큼 나누기

# join - 합치기 (리스트 -> 문자열)
# 형식: '구분자'.join(리스트)  * 구분자가 앞에 옴
print('-'.join(['2025','01','15']))

# split + join
# - split: 문자열 -> 리스트
# - join: 리스트 -> 문자열
raw= '사과, 배, 감'
p= raw.split(',')
print(p)
print('/'.join(p))
print('/'.join([p[0].strip(),p[1].strip(),p[2].strip()]))