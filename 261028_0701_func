# 함수
# 함수의 기본 구조
# 형식:
# def 함수이름():
#   실행할 코드

def greet():
    print('점검을 시작합니다.')

# 정의만으로는 실행 안됨 -> 호출해야 실행
# 호출: 함수 이름 적고 괄호를 붙이기
greet() 

print('실습1: 첫 함수 만들고 호출하기')

def greet():
    print('점검을 시작합니다.')
    print('점검을 시작합니다.')
greet()

print('실습2: 반복 코드를 함수로 정리하기')
def check():
    print('점검을 시작합니다.')
    print('확인요망')
    print('점검을 종료합니다.')

print('펌프')
check()
print('모터')
check()

print('실습3: 함수 실행 흐름 추적하기')
def hello():
    print('안녕하세요.')
hello()
hello() # 안녕하세요 2번 호출됨.

print('실습4: 함수로 설비 점검 자동화하기')
def line():
    print('=' * 10)

def check():
    print('점검을 시작합니다')
    print('기록을 준비하세요')
line()
check()

line()
check()