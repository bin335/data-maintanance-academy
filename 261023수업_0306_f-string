# f-string - 문자열 안에 변수 바로 끼우기
# 형식: f'~~~ {변수}~~' = 따옴표 앞에 f, 변수는 중괄호로 묶는다

name= '홍길동'
age= 25
print(f'{name}님은 {age}살 입니다.')
# 숫자도 str 변환 없이 바로 들어감
print(f'온도: {25.5}℃')
# 중괄호 안에 계산식 가능
hours=3
print(f'{hours*60}분')  # 180분
# 소수점 자릿수 조정
# 형식: {값(변수):.2f} -> 소수점 둘때 자리까지 (자동 반올림)
value= 25.34567
print(f'측정값: {value:.2f}')  # 25.35: 소수점 셋째자리에서 반올림
print(f'측정값: {value:.1f}')  # 25.3: 소수점 둘째자리에서 반올림
