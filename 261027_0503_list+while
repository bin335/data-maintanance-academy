# 최대, 최소
temps = [25,32,28,36,27,31]
biggest = temps[0]  # 초기 최댓값
for t in temps:
    if t>biggest:
        biggest=t  # 더 큰 값일 때 갱신
print(biggest)  # 36

# 빈 리스트 채우기
doubled=[]   # 빈 리스트

for t in temps:
    doubled.append(t*2)     # 빈리스트 .append(추가)로 채우기
print(doubled)    

print('실습3: 조건에 맞는 값만 골라 평균 구하기')
temps= [32,36,31,29,20]
total=0
count=0
high=[]
for t in temps:
    if t>30:
        total +=t
        count +=1
        high.append(t)   # 빈리스트에 조건에 맞는 t값을 추가함
    
print(f'({high}-> 합 {total}, 개수 {count}) 고온평균: {total/count}')

print('실습4: 조건에 맞는 값으로 새 리스트 만들기')
high=[]
for t in temps:
    if t>30:
        high.append(t)
print(f'{high} 개수 {len(high)}')

