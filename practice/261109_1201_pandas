import numpy as np
import pandas as pd

F= 'data/12_metro_compressor_22_261109_1.csv'

# Pandas
# - 표 형태의 데이터를 잘 다루기 위해
# - series: 하나의 열들
# - Dataframe: Series가 모여서 합쳐진 것, 파이썬 안에서 다룰 수 있는 표 구조(df)

# 앞 단원 방식 -> 숫자 열만 골라야 함
# pandas 방식 -> 글자 열까지 그대로, 열은 이름으로

print('실습1: 설비 센서 파일 불러와 확인하기')
df= pd.read_csv(F)
print('데이터 크기:',df.shape)  # 데이터 크기: (200, 7)
print(df.head())

print(df.dtypes)

state= df['가동상태'].values
print('가동상태 종류 개수:',np.unique(state,return_counts=True))
# 가동상태 종류 개수: (array['가동'])가동상태 종류 개수: (array(['가동', '정지'], dtype=object), array([ 96
# 104]))
cur=df['모터전류'].values
print('모터전류 평균 %.2f / 가운데 값 %.2f'%(np.mean(cur),np.median(cur)))
# 모터전류 평균 2.06 /  가운데 값 0.04

s= df['오일온도']
print(s.head(3))

print('실습2: 필요한 열만 이름으로 골라 읽기')
usecols=['측정시각','오일온도','모터전류']
print(pd.read_csv(F,usecols=usecols)) # [200 rows x 3 columns]
print(pd.read_csv(F,nrows=20))  # 20행 3열

print('실습3: 구분자와 인코딩 맞춰 읽기')
