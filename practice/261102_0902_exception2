print('실습4: 여러 파일 묶어 처리하기')
files= [
    'data/08_press_13_261029_3.csv','data/09_ict_inspection_15_261102_1.csv', 
    'data/09_ict_inspection_dirty_15_261102_2.csv','data/09_ict_inspection_dirty_15_261102_4.csv'
]
total=0
for file in files:    # 파일 경로를 하나씩 가져옴
    try:
        with open(file,'r',encoding='utf-8')as f:  # 해당 파일을 열어봄 -> 즉 해당하는 파일이 없으면, 열리지 않음 
            rows= f.readlines()[1:]   # 파일 내용을 읽음
            print('읽기 성공',file,len(rows),'행')   # 성공적으로 읽은 파일만 표시하겠음
            total += 1
    except FileNotFoundError:
        print('건너뜀',file)  # 없는 파일은 건너뛰겠슴
        continue
print('처리한 파일:',total)

print('실습5: 함수 안에서 입력값 검증하기')
def check_value(text, lo=0.0, hi=5000.0):  # check_value 함수
    v=float(text)
    if v<lo or v>hi :
        raise ValueError('범위를 벗어난 값') 
    return v   # v= 입력값
        
for t in ['128.5','결측','-999']:   
    try:
        print('통과',check_value(t))  # check_value함수에 t를 넣어가며 확인
    except ValueError as e:
        print('제외',e)  # e= check_value함수에서 raise 시의 에러메세지