# try-except-else-finally
# - else: 예외가 하나도 안 났을 때만 실행
# - finally: 성공/실패 상관없이 뭄조건 마지막 실행

text= '62.5'
try:
    temp=float(text)
except ValueError:
    print('변환 실패')
else:
    print('변환 성공')
finally:
    print('종료')

print('실습1: finally로 파일 안전하게 닫기')
try:
    f= open('data/09_ict_inspection_15_261102_1','a',encoding='utf-8')
    first= f.readline()
    print(first.strip())   # 헤더
except FileNotFoundError:
