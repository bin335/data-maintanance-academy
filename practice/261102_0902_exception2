# try-except-else-finally
# - else: 예외가 하나도 안 났을 때만 실행
# - finally: 성공/실패 상관없이 뭄조건 마지막 실행

text= '62.5'
try:
    temp=float(text)
except ValueError:
    print('변환 실패')
else:
    print('변환 성공')
finally:
    print('종료')

print('실습1: finally로 파일 안전하게 닫기')
try:
    f= open('data/09_ict_inspection_15_261102_1','r',encoding='utf-8')
    first= f.readline()
    print(first.strip())   # 헤더
except FileNotFoundError:
    print('파일이 존재하지 않습니다.')
finally:
    f.close()
print('파일을 닫았습니다.')

print('실습2: CSV안전하게 읽기')
try:
    with open('data/09_ict_inspection_15_261102_1.csv',encoding='utf-8') as f:
        rows = f.readlines() [1:]    # 슬라이싱 (헤더 빼려고)
except FileNotFoundError:
    rows=[]

total= 0.0
skipped=0
for line in rows:
    try:
        total += float(line.split(',')[2])    # 측정값(2열)
    except (ValueError,IndexError):
        skipped += 1
        continue  # 숫자로 못 바꾸는 칸은 건너뛰고 1로 카운트

print('합계:', round(total,1),'/건너뜀:', skipped)

