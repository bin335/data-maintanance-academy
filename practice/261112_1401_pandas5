# 그룹 집계
# - 분활 -> 적용 -> 결합 구조
# - groupby (): 열, []: 데이터

means=df.groupby('냉각기상태')['온도'].mean()
print(means.round(2))

print(df.groupby('냉각기상태')['온도'].max())

# 여러 키 그룹 코드
