    for su in range(1,10):
        print(dan, 'x',su,'=',dan*su)
    print('---')

print('실습4: 기준을 초과하는 값 개수 세기')
n= int(input('측정횟수: '))
count = 0    # 초과개수 초기화 (처음이니까)
for i in range(n):  # n번 반복
    x= int(input('측정값: '))  # 측정값을 변수에 저장
    if x>80:  # 측정값이 80을 초과하는지 확인
        count +=1  # 조건을 만족하면 개수 1 증가
print('초과개수:',count)  # n번 입력받은 측정값 중에서 80을 초과하는 값의 총개수, 반복문이 끝난 뒤 최종 결과 출력