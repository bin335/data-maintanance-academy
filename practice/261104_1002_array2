# 통계
# - 정상을 알아야 이상을 알 수 있다
# ex) 평균을 알아야 평균과 크게 차이가 나는 값이 나왔을 때 이상치 판단 가능
# - 평균, 최대/최소, 표준편차, 분산
# - Numpy에서 함수 하나로 계산

s= np.array([70,72,71,95,73])
print('합계:',s.sum())
print('평균:',s.mean())
print('중앙값:', np.median(s))
print('최대:',s.max())
print('최소:',s.min())

# 분산 var()
stable=np.array([70,71,70,72,71])
unstable=np.array([60,85,65,95,70])
print(round(stable.var(),1))  # 0.6
print(round(unstable.var(),1)) # 170

# 표준편차 std()
print(round(stable.std(),2))  # 0.75: 소숫점 둘째자리까지 반환
print(round(unstable.std(),2))  # 13.04: 분산의 제곱근(=표준편차)을 반환

# axis 개념 (행/열/방향)
mat= np.array([[70,2.1],[72,2.3]])
print(mat.mean(axis=0))  # axis=0: 열별 평균 (센서별)
print(mat.mean(axis=1))  # axis=1: 행별 평균 (시점별) -> 지금은 큰 의미x
print(mat.mean())  # 전체평균

