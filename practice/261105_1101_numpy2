import numpy as np

F= 'data/11_diecasting_series_20_261105.csv'

ct= np.genfromtxt(F,delimiter=',',skip_header=1,usecols=1,encoding='utf=8')
print(ct.shape,ct.dtype)  # (50,):50개의 데이터가 있다. float64: 소수 형식의 값

def col(n):
    return np.genfromtxt(
        F,
        delimiter=',',
        skip_header=1,
        usecols=n,
        encoding='utf-8'
    )
# 자리 찾기
# fancy indexing: 여러 위치 한번에 추출 가능 (떨어진 자리도 한번에 가능)

vib= np.array([2.1, 2.3, 2.5, 2.7, 2.9])
pick=np.array([0,3])
print(vib[pick])  # 2.1 2.7

# 정렬과 정렬 순서
# - sort,argsort: 원래 자리 번호 돌려줌

print(np.sort(vib))  # [2.1 2.3 2.5 2.7 2.9]
print(np.argsort(vib))  #  [0 1 2 3 4]

print('실습1: 최대 사이클타임 시점 찾기')
i= np.argmax(ct) 
print('배열 인덱스:',i,'\n최대사이클타임',ct[i],'초') # 배열 인덱스: 49 최대사이클타임 6170.0 초

# diff: 변화량 구하고, 급변구간 찾기
vib= np.array([2.0,2.1,2.2,7.0,7.1])
change= np.diff(vib)
print(np.round(change,1))  # [0.1 0.1 4.8 0.1]
print(np.argmax(change))   # 2

print('실습2: 사이클타임 급변 구간 찾기')
change2=np.diff(ct)
print('diff 양수변환:',np.abs(change2),'\n갯수:',np.abs(change2).size)
# 49개
j= np.argmax(change2)
print('j:',np.argmax(change2)) # j: 48
print('48번째 값:',change2[47],'49번째 값:',change2[48], '변화량:',round(change2[48]-change2[47],2))

# clip: 범위 제한 고정
pres=np.array([4.5,9999.0,4.6,-1.0])
fixed=np.clip(pres,0,10)
print(fixed)  # [ 4.5 10.   4.6  0. ] -> 개수는 변하지 않는다.

# cumsum: 누적합
defects= np.array([0,1,0,2,3,5])
print(np.cumsum(defects))  # [ 0  1  1  3  6 11]

# np.where(조건, 참일때 값, 거짓일 때 값) 심화
vib= np.array([2.0,2.1,2.2,7.0,7.1])
label= np.where(vib<2.2,2,np.where(vib>=3,1,0))   
print(label)  # [2 2 0 1 1]

# unique: 중복 정리
# - return_counts 옵션: 각 종류의 개수 확인
status= np.array([0,0,1,0,2,1,0])
kinds,counts= np.unique(status,return_counts=True)
print(kinds)  # [0 1 2]
print(counts)  # [4 2 1

print('실습3: 측정 오류값 범위 안으로 보정하기')
cyl= col(2)
print('원래 평균:',round(cyl.mean(),1))
cyl[0]=9999
print('보정 전 평균:',round(cyl.mean(),1))
fixed= np.clip(cyl,100,300)
print('보정 후 평균:',round(fixed.mean(),1))

print('실습4: 상태를 세 단계로 나누어 세기')
ct=col(1)
label= np.where(ct>=1000,2,(np.where(ct>=50,1,0)))
kinds,counts=np.unique(label,return_counts=True)

names= np.array(['정상','경고','잼'])
print(names[kinds],counts)  # ['정상' '경고' '잼'] [46  2  2]
print(names[kinds],counts/50)  # ['정상' '경고' '잼'] [0.92 0.04 0.04]

# any, all - 조건 충족 여부 판정
# - any: 하나라도 만족하면 True
# - all: 모두 만족해야 True

vib=np.array([2.1,3.5,2.0,6.2])
print(np.any(vib>5))  #  True  
print(np.all(vib<10))  #  True

# concentrate, stack - 배열 합치기 
am= np.array([2.0,2.1,2.2])  
pm= np.array([2.3,2.4,2.5])
print(np.concatenate([am,pm]))  # 1차원 배열 [2.  2.1 2.2 2.3 2.4 2.5]
print(np.stack([am,pm]))   
# 2차원 배열
# [2.  2.1 2.2]
# [2.3 2.4 2.5]]

print('실습5: 다중 센서 행렬 만들고 구간 잘라내기')
stacked=np.stack([col(1),col(2),col(3),col(4)])
print(stacked.shape)  # (4,50) 4행 50열 (기존의 자료는 50행 4열)
recent=stacked[:,-10:] # 마지막 10개(-10)의 열만(:,=only, -10(열):) 잘라서 저장
print(recent.shape)  # (4,10)  4행 10열

print('실습6: 이상 시점 한 번에 정리하기')
i=np.argmax(col(1))
print('최대시점:',int(col(0)[i]),'최대사이클타임:',col(1)[i])  # 최대시점: 50 최대사이클타임: 6170.0

j=np.argmax(np.abs(np.diff(col(1))))
print('급변 구간:',j,'\n',col(1)[j],'->',col(1)[j+1])  # 급변 구간: 48 36.1 -> 6170.0

warning=np.where((col(1)>=50)|(col(2)<150),1,0)  # True=1, False=0
print('경고비율:',warning.mean())  # 경고비율: 0.12

top3= np.argsort(col(1))[::-1][:3] 
# [::-1]: 원래라면 작->큰 이기에, 순서 뒤집기 -> [:3]: 큰->작 순서대로 했을 때, 상위 3개의 행
print(top3)  # [49 47 42]
print('Top3시점:',col(0)[top3])  # Top3시점: [50. 48. 43.]
