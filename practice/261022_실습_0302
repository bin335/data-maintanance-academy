print('실습1: 양수 인덱스로 글자 꺼내기')
word= 'SIGNAL'
print(word[0],word[2],word[5])   # S G L

print('실습2: 음수 인덱스로 뒤에서 꺼내기')
print(word[-1],word[-2])   # L A

print("실습3: 구간 자르기")
print(word[:3])  # SIG: 맨 끝자리인 3번(N)은 생략
print(word[2:5])  # GNA: 2번(G)부터 4번(A)까지

print('실습4: 앞부분 가져오기')
word= 'temp_sensor'
print(word[:4])  # temp: 처음부터 (4-1)번까지 0,1,2,3번의 글자 출력  

print('실습5: 뒤쪽 전체 가져오기')
print(word[5:])  # sensor: 5번부터 끝까지

print('실습6: 뒤 n글자 가져오기')
word= 'sensor_01'
print(word[-2:])   # 01: -2번(0)부터 끝까지

print('실습7: 건너뛰며 가져오기')
word='SIGNAL'
print(word[::2])

print('실습8: 문자열 뒤집기')
print(word[::-1])