print("안녕하세요.")
print(75)

# 형식: print(값)
#- print는 파이썬에 기본으로 들어있는 "내장함수"
#- 괄호 안에 넣은 값을 화면에 그대로 출력

# 여러 번 쓰면 여러 줄로 나옴 (print 한 번 = 한 줄)
print("첫번째 줄")
print("두번째 줄")

# 숫자출력: 따옴표 없이 (따옴표 입력 시, 글자로 인식된다.)
print(75)
print(2.3)

# 문자 출력 - 따옴표로 감싸기
print("설비 데이터 배우기")
print('작은 따음표도 가능!')

# 여러 값 함께 출력 - 쉼표
# 형식: print(값1, 값2, ...)
# 쉼표로 나누면 한줄 사이에 한 칸 띄어짐
print("온도",75) # 출력값= 온도 75

# 계산 결과 출력- 사칙연산
# 형식: 더하기 + 빼기 - 곱하기 * 나누기 /
print("75+5=", 75+5)
print("75-5=",75-5)
print("10*3=",10*3)
print("10/4=",10/4)

# 주석- 사람만 읽는 메모
