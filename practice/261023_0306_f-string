# f-string - 문자열 안에 변수 바로 끼우기
# 형식: f'~~~ {변수}~~' = 따옴표 앞에 f, 변수는 중괄호로 묶는다

name= '홍길동'
age= 25
print(f'{name}님은 {age}살 입니다.')
# 숫자도 str 변환 없이 바로 들어감
print(f'온도: {25.5}℃')
# 중괄호 안에 계산식 가능
hours=3
print(f'{hours*60}분')  # 180분
# 소수점 자릿수 조정
# 형식: {값(변수):.2f} -> 소수점 둘때 자리까지 (자동 반올림)
value= 25.34567
print(f'측정값: {value:.2f}')  # 25.35: 소수점 셋째자리에서 반올림
print(f'측정값: {value:.1f}')  # 25.3: 소수점 둘째자리에서 반올림

print('실습1: f-string으로 변수 끼워 출력하기')
name= 'Pump_A'
temp= 87
print(f'설비{name}, {temp}도')

print('실습2: f-string안에서 계산하기')
a= 10
b= 40
c= 35
print(f'평균: {(a+b+c)/3:.1f}')

print('실습3: 소수점 자릿수 지정하기')
m= 87.456
print(f'{m:.1f}')
print(f'{m:.2f}')

print('실습4: 센서 로그 한 줄 정리 리포트 만들기')
m= ' 5,sensor_2,WARNING,0.78912 '.strip()  # class str
s= m.split(',')
print(s)  # class str
print(f'[센서{s[1]}] 상태{s[2].lower()}, 측정값{float(s[3]):.2f}')
# '0.78912' -> 즉, 문자열로 입력했기에 :.써도 숫자가 아니라서 자릿수 지정 불가능.
# -> float(s[3])을 통해 문자열을 숫자로 바꾼 뒤 :.2f 써야함