print('실습4: zip으로 센서명-값 매핑하기')
names= ['모터온도','진동','압력']
values= [78,0.5,95]
sensors= dict(zip(names,values))  # 두개의 리스트를 dict로 묶기
print(sensors)  # {'모터온도': 78, '진동': 0.5, '압력': 95}
for name, value in sensors.items():
    print(name,':',value)

print('실습5: 임계값으로 경고 센서 분류하기')
values= {'온도': 78, '진동': 0.5, '압력': 95}
max= {'온도': 80, '진동': 0.4, '압력': 100}
warnings= []

for name,value in values.items():
    if value > max[name]:  # 딕셔너리이름[키]로 값을 가져올 수 있다.
        warnings.append(name)
        print('경고센서:',warnings)

print('실습6: 중첩 딕셔너리로 설비 관리하기')
plant= {
    '1번모터': {'온도': 85,'상태': '정상'},
    '2번펌프': {'압력': 77, '상태': '경고'},
    '3번터빈': {'온도': 90, '상태': '경고'}
}
print(plant['2번펌프']['압력'])  # 77
for name, info in plant.items():
   if info['상태']=='경고':
        print(name, '점검필요')

print('실습7: 표 데이터를 딕셔너리로 변환하기')
rows=['온도,78.0','압력,95.0','진동,0.5']  # 세개의 row가 리스트형태로 들어있다
sensors2={}  # 딕셔너리로 변환 후 담을 상자

for row in rows:    # rows속 3개의 row를 각 덩어리로 인식하겠따
    name,value = row.split(',')  # row를 name과 value로 분리하겠다
    sensors2[name]=float(value)  # sensors2딕셔너리에 key=name, 값=value로 저장하겠다는 뜻
print(sensors2)  # 딕셔너리 형태로 출력

print('실습8: 센서데이터 통합 정리')
sensors= {'온도': 78, '진동': 0.5, '압력': 105} # dict
max= {'온도': 80, '진동': 0.4, '압력': 100}  # dict
warnings= set() # set

avg= round(sum(sensors.values())/len(sensors.keys()),1)
print('평균',avg)

for name,value in sensors.items():
    if value>max[name]:
        warnings.add(name)
print('위험센서', sorted(warnings))        
