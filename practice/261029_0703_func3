# 함수 조합
def get_avg(values):
    return sum(values)/len(values)

def judge(avg,limit=80):
    if avg>limit:
        return '위험'
    else:
        return '정상'
temps= [75,88,91]
avg = get_avg(temps)  # values=temps라고 정의하고, 이걸로 평균을 구하겠다는 뜻

print(round(avg,1),judge(avg))

print('실습3: 처리 흐름 만들기')
def get_avg(values):
    return sum(values)/len(values)

def judge(avg,limit=85):
    if avg<=limit:
        return '정상'
    else:
        return '위험'
values= [15,85,90]
avg= get_avg(values)
print(round(avg,1), judge(avg))

print('실습4: 센서 분석 함수 세트 만들기')
def get_avg(values):
    return sum(values)/len(values)

def judge(avg,limit= 80):
    if avg>limit:
        return '경고'
