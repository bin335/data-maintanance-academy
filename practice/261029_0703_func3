# 기본값 인자
# 형식:
# def 함수(필수 매개변수, 선택=기본값): 필수 매개변수가 앞에 나와야한다.

# 거의 항상 같은 값을 매번 적는 번거로움을 줄임, 필요할 때만 덮어쓴다
def report(name,value,unit='도'):  # unit= 반복되는 출력값
    print(f'{name}: {value}{unit}')
report('압축기1',75.3)
report('펌프1', 7.2, 'bar')   # 기본문자('도')에서 bar로 덮어쓰기해줌

print('실습1: 기본값 인자 함수 만들기')
def report(value,limit=80):  # 기본값(80)으로 limit을 지정해줌
    if value>=limit:
        print(f'{value}-> 경고')
    else:
        print(f'{value}-> 정상')
report(78)
report(95)
report(50,40)

