import numpy as np

F = 'data/11_hydraulic_cooler_20_261105.csv'

def col(c):
    return np.genfromtxt(F,delimiter=',',skip_header=1,usecols=c)

# isnan - 결측값 위치 찾기
# - 결측값: 값이 빈 칸 -> 0이 아니라 값을 모름

x= np.array([2.0,np.nan,4.0])
print(np.isnan(x))
print(np.isnan(x).sum())

# nanmean, nanstd - 결측값을 무시한 통계
temp= np.array([70.1,np.nan,71.2,70.8]) 
print(np.mean(temp))  # nan
print(round(np.nanmean(temp),2))  # 70.7

# nanmean, nanmax, nanmin

print('실습1: 결측 확인하고 결측 제외 통계 내기')
vib=col(2)
print('결측:', np.isnan(vib).sum(),'건')  # 결측: 6 건
print('비율:',np.isnan(vib).sum()/len(vib))  # 비율: 0.12
print('결측제외평균',round(np.nanmean(vib),2))  # 결측제외평균 0.57
print('일반평균:',round(np.mean(vib),2))   # 일반평균: nan

# 백분위수, 사분위수 - percentile, quantile
# - 데이터를 크기순으로 줄 세웠을 때 특정 위치의 값
# - 25,50,75 백분위수 -> 1사분위, 중앙값, 3사분위
# - 평균과 달리 극단적인 이상값에 휘둘리지 않음

vib_s=np.array([2.0,2.2,2.3,2.8,3.0,6.5])
print(np.round(float(np.percentile(vib_s,25)),2)) # 2.22
print(np.round(float(np.percentile(vib_s,75)),2))  # 2.95

# 여러자리 한번에
print(np.round(np.percentile(vib_s,[25,50,75]),2))  # 2.95

# quantile: 25 -> 0.25
print(np.round(float(np.quantile(vib_s,0.25)),2))  # [2.22 2.55 2.95]

# 사분위 기반 이상치 범위 - IQR
q1,q3 = np.percentile(vib_s,[25,75])
iqr= q3-q1
upper= q3 + 1.5 * iqr
print(vib_s[vib_s>upper])  # [6.5]

# 평균/표준편차로 정규화 - z-score
# - 부호의 의미: 양수는 평균보다 위, 음수는 아래
# - 방향 무시하고 크기만 보려면 절댓값 필요

z= (vib_s - np.mean(vib_s))/np.std(vib_s)
print(vib_s[np.abs(z)>2])  # [6.5]

print('실습2: IQR로 이상치 찾기')
temp=col(1)
q1,q2= np.percentile(temp,[25,75])  # [35.5 36.3]
iqr= q2-q1
upper= q2 + iqr * 1.5
print(temp[temp>upper],len(temp[temp>upper]),'건')

print('실습3: z-score로 이상 시점 찾기')
time= col(0)
temp=col(1)
z= (temp-np.nanmean(temp))/np.nanstd(temp)
high= np.abs(z)>2
print(high)
print(time[high].astype(int),'최대z스코어:',round(max(z),2))  # [47 48 49 50] 최대z스코어: 3.39
# [high] bool타입-> time[high]: time에서 high값의 인덱스 번호를 반환해줌.

print('실습4: 3시그마 경보 판정하기')
limit= np.nanmean(temp) + 3*np.nanstd(temp)
print('상한',round(limit,2),time[ temp > limit].astype(int)) # 상한 55.58 [47 48 49 50]

# 센서 간 상관관계 - corrcoef
# - 세기는 절댓값이 정함. +0.99와 -0.99는 세기가 똑같고 방향만 반대
# - 양수: 한쪽이 오르면 다른 한쪽도 오름 / 음수는 반대
# - 0에 가까움 -> 관계가 없는 상태

temp= np.array([70,72,74,76,78])
vib= np.array([2.0,2.2,2.5,2.7,3.0])
# 상관행렬의 [0,1] 칸이 두 센서의 상관계수
print(round(float(np.corrcoef(temp,vib)[0,1]),3))  # 0.998
# 표(행렬)
print(np.round(np.corrcoef(temp,vib),3))
#[[1.    0.998]
# [0.998 1.   ]]
# 온도-온도, 온도-진동, 진동-온도, 진동-진동 네 조합을 모두 계산해 줌

# 2D배열 axis별 통계 활용
# 행은 센서, 열은 시점인 행렬 axis로 방향을 정해 통계
# axis= 1 - 각 행을 옆으로 > 센서별 통계 > 배열들을 열로 배치
# axis= 0 - 각 열을 아래로 > 시점별 통계 > 배열들을 행으로 배치

data= np.array([[70.,72.,74.],[2.0,2.2,2.5]])
print(data)
print(np.round(np.mean(data,axis=1),2))  # [72.    2.23]
print(np.round(np.mean(data,axis=0),2))  # [36.   37.1  38.25]

print('실습5: 센서 간 상관관계 확인하기')
temp=col(1)
c_e=col(3)
print(round(float(np.corrcoef(temp,c_e)[0,1]),2))  # -0.99
print(np.round(np.corrcoef(temp,c_e)[0,1],2))  # [0,1]: 표에서 필요한 한 칸만 꺼냄. -0.99
print('온도가 오르면 냉각효율은 거의 비례하여 떨어짐')

print('실습6: 센서별 통계 한 번에 구하기')
vib=col(2)
po=col(4)
table=np.stack([temp,vib,c_e,po])
print(np.round(np.nanmean(table,axis=1),1)) # [37.7  0.6 44.7 57.7]
print(np.round(np.nanstd(table,axis=1),1))  # [6.  0.1 7.6 1.6]

# 변화점 탐지
# - 누적 합으로 찾는 원리
# - 각 값에서 전체 평균을 빼면 평균보다 작은 값은 음수, 큰 값은 양수
# - 해당 값들을 앞에서부터 누적하면 평균보단 작은 구간에서는 계속 내려가고,
# - 평균보다 높은 구간에서는 계속 올라감
# - 그래서 누적 곡선이 가장 낮아지는 자리가 내려가기를 멈추고 올라가기 시작한 자리

v= np.array([2.0,2.1,2.0,5.0,5.2,5.1])
cs=np.cumsum(v-np.mean(v))
print(np.argmin(cs))   # 2

print('실습7: 변화 경계 후보 찾기')
cs= np.cumsum(temp-np.nanmean(temp))
print('경계후보:',int(time[np.argmin(cs)]))  # 45

print('실습8: 종합 이상 점수로 정비 우선순위 정하기')
temp_z=np.abs((temp-np.nanmean(temp))/np.nanstd(temp))
ce_z=np.abs((c_e-np.nanmean(c_e))/np.nanstd(c_e))
score= temp_z+ce_z

i= np.nanargmax(score)
top3= np.argsort(score)[::-1][:3]

print('최고점수:',int(time[i]),'번', '점수:',round(score[i],2))
print('상위 세 시점:',time[top3].astype(int))  # 상위 세 시점: [50 49 48]
