import numpy as np

F = 'data/11_hydraulic_cooler_20_261105.csv'

def col(c):
    return np.genfromtxt(F,delimiter=',',skip_header=1,usecols=c)

# isnan - 결측값 위치 찾기
# - 결측값: 값이 빈 칸 -> 0이 아니라 값을 모름

x= np.array([2.0,np.nan,4.0])
print(np.isnan(x))
print(np.isnan(x).sum())

# nanmean, nanstd - 결측값을 무시한 통계
temp= np.array([70.1,np.nan,71.2,70.8]) 
print(np.mean(temp))  # nan
print(round(np.nanmean(temp),2))  # 70.7

# nanmean, nanmax, nanmin

print('실습1: 결측 확인하고 결측 제외 통계 내기')
vib=col(2)
print('결측:', np.isnan(vib).sum(),'건')  # 결측: 6 건
print('비율:',np.isnan(vib).sum()/len(vib))  # 비율: 0.12
print('결측제외평균',round(np.nanmean(vib),2))  # 결측제외평균 0.57
print('일반평균:',round(np.mean(vib),2))   # 일반평균: nan

# 백분위수, 사분위수 - percentile, quantile
# - 데이터를 크기순으로 줄 세웠을 때 특정 위치의 값
# - 25,50,75 백분위수 -> 1사분위, 중앙값, 3사분위
# - 평균과 달리 극단적인 이상값에 휘둘리지 않음

vib_s=np.array([2.0,2.2,2.3,2.8,3.0,6.5])
print(np.round(float(np.percentile(vib_s,25)),2)) # 2.22
print(np.round(float(np.percentile(vib_s,75)),2))  # 2.95

# 여러자리 한번에
print(np.round(np.percentile(vib_s,[25,50,75]),2))  # 2.95

# quantile: 25 -> 0.25
print(np.round(float(np.quantile(vib_s,0.25)),2))  # [2.22 2.55 2.95]

# 사분위 기반 이상치 범위 - IQR
q1,q3 = np.percentile(vib_s,[25,75])
iqr= q3-q1
upper= q3 + 1.5 * iqr
print(vib_s[vib_s>upper])  # [6.5]

# 평균/표준편차로 정규화 - z-score
# - 부호의 의미: 양수는 평균보다 위, 음수는 아래
# - 방향 무시하고 크기만 보려면 절댓값 필요

z= (vib_s - np.mean(vib_s))/np.std(vib_s)
print(vib_s[np.abs(z)>2])  # [6.5]

print('실습2: IQR로 이상치 찾기')
temp=col(1)
q1,q2= np.percentile(temp,[25,75])  # [35.5 36.3]
iqr= q2-q1
upper= q2 + iqr * 1.5
print(temp[temp>upper],len(temp[temp>upper]),'건')

print('실습3: z-score로 이상 시점 찾기')
time= col(0)
temp=col(1)
z= (temp-np.mean(temp))/np.std(temp)
high= temp[np.abs(z)>2]
print(high,'최대z스코어:',round(max(z),2))
