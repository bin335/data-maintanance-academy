# 모듈/ 패키지/ 라이브러리
# - 모듈: 기능을 모아둔 .py파일 하나
# - 패키지: 모듈을 모아둔 폴더
# - 라이브러리: 위에 사항들을 통칭

# import 방식
# 형식: import 모듈
import math   # math라는 모듈을 통째로 불러옴
print(math.sqrt(16))  # 4.0
from math import sqrt,ceil   # 일부만 불러옴 -> 모듈명 없이 바로 사용
print(sqrt(16),ceil(4.2))
import math as m  # as별칭: 모듈에 짧은 이름을 붙이는 것
print(m.sqrt(16))

print('실습1: import세 방식으로 모듈 가져오기')
import math
print(math.sqrt(25))

from math import sqrt,ceil  # ceil: x보다 큰 정수값 중 가장 작은 값을 반환
print(sqrt(25),ceil(4.7))

import math as m
print(m.sqrt(25))

