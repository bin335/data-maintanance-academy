    print('숫자아님')
except IndexError:
    print('칸 부족')

print('실습3: 구체적 예외로 입력 검증하기')
while True:  # break를 만날 때까지 반복
    value = input('값 (종료: q): ')
    if value == 'q':
        break  # 반복문 종료

    try:
        data = int(value)
        print(100 / data)
    except ValueError:
        print('숫자아님')

    except ZeroDivisionError:
        print('0으로 나눌 수 없음')
    
