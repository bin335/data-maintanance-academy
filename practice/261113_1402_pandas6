import pandas as pd
F= 'data/14_hydraulic_26_261112_1.csv'
F_QC='data/14_hydraulic_qc_26_261112_2.csv'

df= pd.read_csv(F)
qc=pd.read_csv(F_QC)

# 그룹 통계와 상관관계
# - 그룹통계 -> 원본 행과 그룹 기준 비교 -> 두 기준 표 -> 상관관계

print(round(df['온도'].mean(),2))
print(round(df['온도'].std(),2))

print(df.groupby('냉각기상태')['온도'].mean().round(2))
# 냉각기상태
# 고장    54.67
# 저하    45.46
# 정상    35.89
print(df.groupby('냉각기상태')['온도'].std().round(2))
# 냉각기상태
# 고장    3.76
# 저하    1.47
# 정상    0.36

# 분산/ 표준편차
v= df.groupby('냉각기상태')['온도'].var()
std= df.groupby('냉각기상태')['온도'].std()
print(v.round(2)) # 고장    3.76  저하    1.47  정상    0.36
print(std.round(2))  #  고장    14.13  저하     2.15  정상     0.13
print((std ** 2).round(2))  # 분산^2= 표준편차: 고장    14.13  저하     2.15  정상     0.13

# agg- 여러 통계 한번에 표로 모으기
#  ㄴ 리스트: 같은 대상에 여러 통계
#  ㄴ 딕셔너리: 열별 통계
#  ㄴ named aggregation: 결과 열의 이름까지 지정

print(df.groupby('냉각기상태')['온도']
      .agg(['mean','std','max']).round(2))
print(df.groupby('냉각기상태')[['온도','진동']]
      .agg(['mean','std','max']).round(2))
# 냉각기상태                   
# 고장     54.67  3.76  57.8
# 저하     45.46  1.47  51.2
# 정상     35.89  0.36  36.4

# 이름 붙이기
summary= df.groupby('냉각기상태').agg(
    평균온도=('온도','mean'),
    평균진동=('진동','mean')
)
print(summary.round(2))

# 열별로 다른 통계 목록 지정
summary2= df.groupby('냉각기상태').agg({
    '온도': ('mean','std'),
    '진동': ('mean','max')
})
print(summary2.round(2))
    #   온도          진동      
    #     mean   std  mean   max
# 냉각기상태                         
# 고장     54.67  3.76  0.69  0.78
# 저하     45.46  1.47  0.61  0.63
# 정상     35.89  0.36  0.55  0.57

print('실습1: 여러 통계를 한 표로 모으기')
print(qc.head(1))
print(qc['검사결과'].value_counts())  # 합격     188    불합격     12
# 1. 목록 방식
list=qc.groupby('검사결과')['온도'].agg(
['mean','std','max']).round(2)
print(list)
# 검사결과                   
# 불합격   55.84  1.32  57.5
# 합격    35.91  0.97  44.7
# 2. 이름 붙이기 방식
summary= qc.groupby('검사결과').agg(
    평균온도= ('온도','mean'),
    평균냉각효율=('냉각효율','mean'),
    측정수=('검사결과','value_counts')
)
print(summary.round(2))
#    평균온도  평균냉각효율  측정수
# 검사결과                    
# 불합격   55.84   19.65   12
# 합격    35.91   46.88  188

# 3. 불합격 정리
fail= qc[qc['검사결과']=='불합격']
summary_fail= fail.groupby('검사결과').agg({
    '온도': ['mean','std'],
    '냉각효율': ['mean'],
    '검사결과': ['size']
}).round(2)
print(summary_fail)

# transform
# 원래 행 인덱스와 모양을 유지한다.

# 같은 그룹의 평균 붙이기
print(df.groupby("냉각기상태")["온도"].mean().shape)    #  (3,)
print(df.groupby("냉각기상태")["온도"].transform('mean').shape) #  (120,)

marked= df.copy()
marked['그룹평균']= marked.groupby('냉각기상태')['온도'].transform('mean')
marked['편차']= marked['온도'] - marked['그룹평균']
print(marked[['냉각기상태','그룹평균','편차']].head(3).round(2))
#  냉각기상태   그룹평균     편차
# 0    고장  54.67 -19.07
# 1    고장  54.67  -7.17
# 2    고장  54.67  -3.97

# pivot_table - 두 기준 표를 한 번에
# - margins=True  -> 전체 집계 추가
# - 값이 없는 조합의 쳥균을 0으로 메우지 않도록

temp_table = pd.pivot_table(df,index='밸브상태',columns='운전부하',values='온도'
                            , aggfunc='mean', margins=True,margins_name='전체')
print(temp_table.round(2))
# 운전부하    고부하    저부하     전체
# 밸브상태                     
# 경미    42.20  47.52  44.86
# 심각    45.25  47.09  46.02
# 정상    39.34  49.40  45.11
# 지연    43.75  49.79  45.86
# 전체    41.85  48.82  45.34

# - index: 결과표의 행을 나누는 기준
# - columns: 결과표의 열을 나누는 기준
# - values: 각 칸에서 계산할 측정값
# - aggfunc: 그 측정값으로 요약
# - margins=True: 전체 집계 행,열 추가
# - margins_name: 추가 집계 이름 표시

print('실습2: 되돌려 붙이고 두 기준 표로 보기')
marked=df.copy()
marked['그룹평균']= marked.groupby('냉각기상태')['온도'].transform('mean')

marked['편차']= marked['온도'] - marked['그룹평균']
cols= ['냉각기상태','온도','그룹평균','편차']
print(marked[cols].head(3).round(2))
# 0   -19.07
# 1    -7.17
# 2    -3.97

# 편차의 절댓값 중 최대
max_idx= marked['편차'].abs().idxmax()
print(round(marked.loc[max_idx,'편차'],2),marked.loc[max_idx,'냉각기상태'])


temp_table2=pd.pivot_table(df,index='밸브상태',columns='운전부하',values='온도',
                           aggfunc='mean',margins=True,margins_name='전체')
print(temp_table2.round(2))

# corr - 두 지표의 상관계수 구하기
print(round(df['온도'].corr(df['진동']),3))  # 0.931
print(round(df['온도'].corr(df['냉각효율']),3))  # -0.951
print(round(df['온도'].corr(df['압력']),3))   # 0.284

print('실습3: 두 센서의 관계 재어 보기')
print(round(df['온도'].corr(df['진동']),3))   # 0.931
print(round(df['온도'].corr(df['냉각효율']),3))  # -0.951
print(round(df['온도'].corr(df['압력']),3))   # 0.284

print(round(df[['온도','진동','냉각효율','압력']].corr(),3))
#          온도     진동   냉각효율     압력
# 온도    1.000  0.931 -0.951  0.284
# 진동    0.931  1.000 -0.862  0.524
# 냉각효율 -0.951 -0.862  1.000 -0.131
# 압력    0.284  0.524 -0.131  1.000

corr=df[['온도','진동','냉각효율','압력']].corr()
pairs= corr.stack()
pairs= pairs[pairs.index.get_level_values(0)< pairs.index.get_level_values(1)]
# stack(): 상관계수 표를 세로 형태로 변환
# get_level_values(): 자기 자신과 중복된 쌍 제외하기
print(pairs)

print('가장 강한 쌍:',pairs.abs().idxmax(),round(pairs.loc[pairs.abs().idxmax()],3))  # idxmax(): 가장 큰 값의 인덱스 반황
# 가장 강한 쌍: ('냉각효율', '온도') -0.951
print('가장 약한 쌍:',pairs.abs().idxmin(),round(pairs.loc[pairs.abs().idxmin()],3))  # idxmin(): 가장 작은 값의 인덱스 반환
# 가장 약한 쌍: ('냉각효율', '압력') -0.131
