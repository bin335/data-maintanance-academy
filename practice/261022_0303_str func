# 문자열 연산과 검색
#- 문자열 연결(+), 반복(*)

# len() - 글자 수
# 형식: len(문자열)
print(len('PYTHON'))  # 6 : 6글자
print(len('AI 분석'))  # 5: 공백도 한글자로 포함 
print(len(''))  # 0: 괄호 안 공백이라 

# in / not in - 포함 / 불포함 여부 (결과 bool)
# 형식: '찾을 것' in 문자열
print('고장' in '설비 고장 발생')
print('정상'not in '고장')

# count
# 형식: 문자열.count('x') -> 개수 세기
print('banana'.count('a'))
print('abcd'.count(','))  # 찾고자 하는게 없을 때(공백)는 count안에 ,를 삽입

# find
# 형식: 문자열.find('x') -> 처음 나오는 위치
print('banana'.find('a'))  # 1
print('banana'.find('t'))  # -1: 찾고자 하는 값이 없을 때는 이렇게 나온다.

# index
# 주의) 위치를 반환하지만, 없으면 오류
email= 'hong@company.com'
at = email.index('@')
print(at) #4
print(email[:at])  # hong

# startswith / endswitch
# 형식: 문자열.startswith('x')  -> bool
print('EQP-001'.startswith('EQP'))
print('EQP-001'.endswith('001'))

# ==
# 주의) 컴퓨터는 대문자와 소문자를 다른 글씨로 봄 -> 통일 해야함
label='WARNING'
print(label=='warning') # False: 대소문자 통일 필요

print('실습1: 길이 재기')
num= '01012345678'
print(len(num))

print('실습2: 포함 확인하기')
print('고장' in '설비 고장 발생')  # True
print('정상' in '설비 고장 발생')  # False 

print('실습3: 개수 세기')
temp= 'sensor-01-temp'
print(temp.count('-'))  # 2

print('실습4: 위치 찾기')
print('temp_2024'.find('_'))  # 4
print('temp_2024'.find('s'))  # -1

print('실습5: 시작과 끝 확인하기')
word= 'sensor_long.csv'
print('sensor_long.csv'.startswith('sensor'))  # True
print(word.endswith('.csv'))  # True

print('실습6: 대소문자 구분 확인하기')
label='WARNING'
print(label=='warning')  # False: 대소문자 구분