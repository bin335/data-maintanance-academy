# 인덱싱- 위치 번호로 글자 하나 꺼내기
# 형식: word[번호]  (첫 글자= 0번)

word= 'PYTHON'
print(word[0],word[2],word[5])  # P T N
# 음수 인덱스: 뒤에서부터 -1, -2,...
print(word[-1],word[-2])  # N O

# print(word[6])      # index error: string index out of the range
# 형식: 문자열[시작:끝]   (시작 포함, 끝 제외)
print(word[1:4])    # YTH: 끝(4번)을 제외한 1,2,3번의 글자가 출력
# 생략 가능
# - 시작 생략 = 처음부터 (0번부터)
# - 끝 생략 = 끝까지
# - 둘 다 생략 = 전체
print(word[:3])    # PYT
print(word[3:])    # HON
print(word[:])     # PYTHON 
# 음수의 경우
print(word[-3:])   # HON: 뒤에서 세 글자 (-3~-1)
print(word[:-1])   # PYTHO: 맨 끝자리(-1번)를 제외한 처음부터 끝까지

 #step 간격 주기
 # 형식: 문자열[시작:끝:간격]
print(word[::2])  # PTO
print(word[1::3]) # YO
print(word[::-1])

print('실습1: 양수 인덱스로 글자 꺼내기')
word= 'SIGNAL'
print(word[0],word[2],word[5])   # S G L

print('실습2: 음수 인덱스로 뒤에서 꺼내기')
print(word[-1],word[-2])   # L A

print("실습3: 구간 자르기")
print(word[:3])  # SIG: 맨 끝자리인 3번(N)은 생략
print(word[2:5])  # GNA: 2번(G)부터 4번(A)까지

print('실습4: 앞부분 가져오기')
word= 'temp_sensor'
print(word[:4])  # temp: 처음부터 (4-1)번까지 0,1,2,3번의 글자 출력  

print('실습5: 뒤쪽 전체 가져오기')
print(word[5:])  # sensor: 5번부터 끝까지

print('실습6: 뒤 n글자 가져오기')
word= 'sensor_01'
print(word[-2:])   # 01: -2번(0)부터 끝까지

print('실습7: 건너뛰며 가져오기')
word='SIGNAL'
