# while - 조건이 참인 동안 반복
# 형식:
# while 조건식:      (조건이 거짓이 되는 순간 멈춤)
# for - '몇 번'이 정해졌을 떄, while은 '언제 끝날지 모르므로 끝나는 조건을 지정해주어야함'

count=1
while count <=3:
    print(count)
    count += 1   # 처음숫자에서 1씩 올라간다.-> 이 줄이 없으면 안 멈춤
# 주의) 무한루프를 막으려면 (1)언젠가 거짓이 될 조건, (2)반복문 안에서 그 조건을 갱신
# 처음부터 조건이 거짓이면 한 번도 실행되지 않는다

print('실습1: while로 목표값 도달까지 반복하기')
# 1. 시작상태 지정: 조건변수 출발값 정하기
goal= 7  # 목표값 설정
n= 0     # 조건변수의 초기값 설정

# 2. 종료조건: 멈출 상태의 반대를 조건식으로 설정
while n != goal:  #  n이 7이 아닌 동안 반복

# 3. 갱신방법: 종료를 향히 조건변수의 값 바꾸기
    n= int(input('값을 입력하세요.: '))  
    if n != goal:   #
        print('아직 조건값이 아니다.')
    else :
        print('정답입니다!')   
